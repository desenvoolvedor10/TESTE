    "import random\n",
    "import socket\n",
    "\n",
    "laptop = socket.gethostname()\n",
    "segredo = random.randint(1, 20)\n",
    "\n",
    "print(f\"[{laptop}] Adivinhe o número de 1 a 20! Você tem 5 tentativas.\")\n",
    "\n",
    "for tentativa in range(1, 6):\n",
    "    palpite = int(input(f\"Tentativa {tentativa}/5 - seu número: \"))\n",
    "\n",
    "    if palpite == segredo:\n",
    "        print(\"ACERTOU! Parabéns!\")\n",
    "        break\n",
    "    elif palpite < segredo:\n",
    "        print(\"O número é MAIOR.\")\n",
    "    else:\n",
    "        print(\"O número é MENOR.\")\n",
    "else:\n",
    "    print(f\"Acabaram as tentativas. O número era {segredo}.\")\n"
   ]
